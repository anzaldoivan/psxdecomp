#!/bin/sh
# psxd — run one psxdecomp script with a Python >= 3.11 (tomllib). Usage: psxd <script> [args...]
#   psxd preflight --target .     psxd identify <dump>     psxd install stage S5     psxd fetch_refs --lint
# The interpreter: $CLAUDE_PLUGIN_OPTION_PYTHON_PATH, else the newest python3.N on PATH, else python3.
here=$(cd "$(dirname "$0")" && pwd)
name=$1; shift 2>/dev/null
[ -n "$name" ] && [ -f "$here/$name.py" ] || { echo "usage: psxd <preflight|identify|answers|install|fetch_refs|doctor|upgrade|decompdev> [args]" >&2; exit 2; }
for py in "$CLAUDE_PLUGIN_OPTION_PYTHON_PATH" python3.14 python3.13 python3.12 python3.11 python3; do
  [ -n "$py" ] || continue
  command -v "$py" >/dev/null 2>&1 || [ -x "$py" ] || continue
  if "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    exec "$py" "$here/$name.py" "$@"
  fi
done
echo "psxd: no Python >= 3.11 found (set the plugin's python_path option)" >&2
exit 1
